# Copy to .env and fill in. NEVER commit a real .env.
# Strong random secret used to sign sessions/CSRF. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Environment: dev | prod  (prod => Secure cookies + HSTS)
ENV=dev

# Force secure cookies regardless of ENV: auto | true | false
COOKIE_SECURE=auto

# Session lifetime in seconds (default 43200 = 12h)
SESSION_TTL=43200

# Database. Default is local SQLite. For Postgres:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/sentinelops
DATABASE_URL=sqlite:///./sentinelops.db

# Optional: auto-create an admin on first boot (otherwise the first
# self-registered user becomes admin).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enable LLM answers in the AI analyst
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
